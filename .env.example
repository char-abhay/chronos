# The site's public origin, used for metadataBase, robots.txt, sitemap.xml
# and the Open Graph image URL.
#
# Leave this unset on Vercel: the deploy reads VERCEL_PROJECT_PRODUCTION_URL
# and describes itself correctly with no configuration. Set it only when a
# real custom domain exists, and include the scheme, with no trailing slash.
#
# NEXT_PUBLIC_SITE_URL=https://example.com
